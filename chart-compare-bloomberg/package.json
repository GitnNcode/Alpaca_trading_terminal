{
  "name": "chart-compare-bloomberg",
  "version": "0.1.0",
  "private": true,
  "description": "Bloomberg-style desktop port of the chart + compare GUI (Electron + TypeScript + Python).",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n PY,MAIN,RENDERER -c yellow,blue,magenta \"npm:dev:py\" \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:py": "python3 python/server.py --port 8765",
    "dev:main": "tsc -p tsconfig.main.json -w",
    "dev:renderer": "vite",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "py:install": "python3 -m pip install -r python/requirements.txt",
    "py:run": "python3 python/server.py"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "lightweight-charts": "^4.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
